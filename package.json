{
  "name": "tradent",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @tradent/db generate",
    "db:migrate": "pnpm --filter @tradent/db migrate",
    "db:seed": "pnpm --filter @tradent/db seed",
    "worker": "pnpm --filter @tradent/worker start",
    "web": "pnpm --filter @tradent/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
