# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgres://tradent:tradent@localhost:5432/tradent
ANTHROPIC_API_KEY=
# Free Gemini key from Google AI Studio, for the Gemini 3.8 Flash model (Decision 22).
GEMINI_API_KEY=
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
# Sandbox only. The MVP has no live trading path (CLAUDE.md hard rule 1).
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.sandbox.alpaca.markets

# Sign-in (Better Auth, Decision 17). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local development and tests only: sign in as any user without a password. Never set on a public deployment.
TRADENT_DEMO_SIGN_IN=false

# Hosted deployments without the worker (Vercel): the bearer token GitHub Actions sends to /api/cron/tick.
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Optional: site-wide monthly AI spend cap in dollars across all developers (default 50).
TRADENT_SITE_AI_CAP_USD=
